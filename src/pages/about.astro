---
import Base from '../layouts/Base.astro';
---
<Base
  title="About"
  active="about"
  description="Haotian Fu beyond the lab: distance running, including a 3:03 marathon and other race results."
>
  <section class="pagehead">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>A marathon runner.</h1>
      <p>
        Outside the lab, distance running is the other long-term project I work on.
        Races give me checkpoints; what I enjoy most is the quiet rhythm of training.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <article class="runner-card">
        <div class="runner-photo">
          <img src="/assets/img/FM.jpg" alt="Finishing the Suffolk County Marathon in Babylon" />
        </div>
        <div class="runner-copy">
          <div class="meta">First full marathon</div>
          <h3>2025 Suffolk County Marathon</h3>
          <div class="time-mark">3:03:34.7</div>
          <p>Overall 5 / 317 · Age group 1 / 31</p>
        </div>
      </article>

      <article class="runner-card">
        <div class="runner-photo">
          <img src="/assets/img/HM.jpg" alt="Running a half marathon in Brooklyn" />
        </div>
        <div class="runner-copy">
          <div class="meta">First half marathon</div>
          <h3>2025 NYCRuns Brooklyn Ice Cream Social Half &amp; 5K</h3>
          <div class="time-mark">1:26:39</div>
          <p>Overall 13 / 941 · Age group 3 / 234</p>
        </div>
      </article>

      <article class="runner-card">
        <div class="runner-photo">
          <img src="/assets/img/10K.jpg" alt="Great Cow Harbor 10K in Northport" />
        </div>
        <div class="runner-copy">
          <div class="meta">10K personal best</div>
          <h3>2025 Great Cow Harbor 10K</h3>
          <div class="time-mark">36:00.00</div>
          <p>Overall 62 / 2243 · Age group 17 / 140</p>
        </div>
      </article>
    </div>
  </section>
</Base>
