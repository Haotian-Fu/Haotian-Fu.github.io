---
import Base from '../layouts/Base.astro';
---
<Base
  title="Resume"
  active="cv"
  description="Download Haotian Fu's CV for 2027 summer internship applications in sensing systems and healthcare research."
>
  <section class="pagehead">
    <div class="container">
      <span class="eyebrow">Resume</span>
      <h1>Curriculum vitae.</h1>
      <p>
        I am seeking a 2027 summer internship. Two versions of my CV are written to
        different application roles.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="twocol">
        <article class="card cv-card">
          <span class="eyebrow">Recommended</span>
          <h3>General CV</h3>
          <p>Sensing systems and infrastructure, ML Engineering. Use this for most 2027 summer internship applications.</p>
          <a class="button" href="/assets/Haotian_Fu_CV.pdf" target="_blank" rel="noopener">Download PDF</a>
        </article>
        <article class="card cv-card">
          <span class="eyebrow">Domain variant</span>
          <h3>Healthcare CV</h3>
          <p>Noninvasive sensing and smart aging. For health-sensing, aging, or biomedical-adjacent roles.</p>
          <a class="button ghost" href="/assets/Haotian_Fu_CV_BCI.pdf" target="_blank" rel="noopener">Download PDF</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="eyebrow">Skills</span>
      <h2>Tools I use day to day</h2>
      <div class="modality-grid">
        <div class="mod">
          <b>Programming</b>
          <p>Python, C/C++, SQL, R, MATLAB</p>
        </div>
        <div class="mod">
          <b>ML &amp; scientific computing</b>
          <p>PyTorch, CUDA, NumPy, SciPy, scikit-learn</p>
        </div>
        <div class="mod">
          <b>Tools &amp; frameworks</b>
          <p>Git, Slurm, Docker, Linux, AWS (S3, Lambda), Node.js</p>
        </div>
        <div class="mod">
          <b>Sensing stack</b>
          <p>UWB radar, RGB-D, Android application development</p>
        </div>
      </div>
      <div class="skill-row" style="margin-top:18px">
        <span class="chip">Multimodal sensing</span>
        <span class="chip">Sensing infrastructure</span>
        <span class="chip">Dataset curation</span>
        <span class="chip">Machine learning</span>
        <span class="chip">Mobile computing</span>
      </div>
      <p class="tiny" style="margin-top:18px">
        Contact:
        <a class="inline-link" href="mailto:haotian.fu01@gmail.com"> haotian.fu01@gmail.com </a>
         · 
        <a class="inline-link" href="https://www.linkedin.com/in/haotian-fu" target="_blank" rel="noopener"> LinkedIn </a>
         ·  Stony Brook, NY
      </p>
    </div>
  </section>
</Base>
