---
import Base from '../layouts/Base.astro';
import HeroFigure from '../components/HeroFigure.astro';
---
<Base title="Haotian Fu" active="home">
  <section class="intro">
    <div class="container intro-grid">

      <!-- Left: Personal Information -->
      <div class="intro-copy">
        <h1 class="display-name">Haotian Fu</h1>
        <p class="name-cn">付昊天</p>

        <div class="intro-details">
          <p class="role">
            Ph.D. Student, Computer Engineering
          </p>

          <p class="role affiliation">
            <a
              class="inline-link"
              href="https://www.stonybrook.edu/electrical/"
              target="_blank"
              rel="noopener"
            >ECE Department</a>,
            <span class="nowrap">
              <a
                class="inline-link"
                href="https://www.stonybrook.edu/"
                target="_blank"
                rel="noopener"
              > Stony Brook University</a>
            </span>
          </p>

          <p class="role">
            Advised by
            <a
              class="inline-link"
              href="https://www.ece.stonybrook.edu/~fanye/index2.html"
              target="_blank"
              rel="noopener"
            > Prof. Fan Ye</a>
          </p>
        </div>

        <nav class="quiet-links" aria-label="Personal links">
          <a href="/cv">CV</a>
          <a href="mailto:haotian.fu01@gmail.com">Email</a>
          <a
            href="https://github.com/Haotian-Fu"
            target="_blank"
            rel="noopener"
          >GitHub</a>
          <a
            href="https://www.linkedin.com/in/haotian-fu"
            target="_blank"
            rel="noopener"
          >LinkedIn</a>
        </nav>

        <p class="interests">
          <strong>Research interests:</strong> multimodal sensing,
          sensing infrastructure, and mobile computing.
        </p>
      </div>

      <!-- Right: Portrait -->
      <figure class="intro-photo">
        <img
          src="/assets/img/avatar.jpg"
          alt="Portrait of Haotian Fu"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>
          Captured at SJTU Undergraduate Commencement Ceremony,
          Shanghai, China
        </figcaption>
      </figure>

    </div>
  </section>

  <section class="section" id="hello">
    <div class="container measure">
      <h2>Hello.</h2>
      <p>
        I am a third-year Ph.D. student in Computer Engineering at Stony Brook University.
        I build end-to-end sensing systems for indoor localization, activity recognition,
        and home-health monitoring with spanning UWB / RF sensing, multi-modality fusion,
        dataset collection and curation, and deep learning on GPU clusters.
      </p>
      <p>
        I am currently seeking a <strong>2027 summer internship</strong> in sensing systems,
        machine learning, or related applied research.
      </p>
    </div>
  </section>

  <section class="section" id="exhibit">
    <div class="container">
      <h2 class="room-title">Selected work</h2>
      <figure class="exhibit">
        <HeroFigure />
        <figcaption>
          Schematic diagram of a setup in a four-room apartment. Sixteen UWB radars, six RGB-D cameras,
          and wearables share one clock during continuous activities of daily living (ADLs).
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="research">
    <div class="container">
      <h2 class="room-title">Research</h2>
      <div class="catalog">
        <article class="catalog-item">
          <span class="catalog-no">01</span>
          <div>
            <h3>Multimodal Continuous ADL Dataset</h3>
            <p>
              Led continuous activities in daily living (ADLs) dataset acquisition and quality assessment including 113 long-duration ADL sessions
              with 16 UWB radars, 6 Kinect cameras, and wearables, including an Android
              collection app and metadata workflows.
            </p>
            <a class="text-arrow" href="/research">Read more</a>
          </div>
        </article>
        <article class="catalog-item">
          <span class="catalog-no">02</span>
          <div>
            <h3>Indoor Human Lcaolization and Tracking</h3>
            <p>
              Physics-informed UWB range estimation and particle-filter fusion over 16 sensors.
              0.958 m range RMSE, over 30% lower error than representative baselines.
              Accepted at IEEE GLOBECOM 2026.
            </p>
            <a class="text-arrow" href="/publications">Paper</a>
          </div>
        </article>
        <article class="catalog-item">
          <span class="catalog-no">03</span>
          <div>
            <h3>ADL-CLIP Reproduction and Extension</h3>
            <p>
              Reproducing a Transformer RF–text contrastive model and evaluating
              cross-population generalization on Slurm-managed NVIDIA H200/B40 clusters.
            </p>
            <a class="text-arrow" href="/research">Read more</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="news">
    <div class="container measure">
      <h2 class="room-title">News</h2>
      <ul class="news">
        <li><time>2026</time><span>Seeking a 2027 summer internship.</span></li>
        <li><time>2026</time><span>ScoreKFT accepted at IEEE GLOBECOM 2026.</span></li>
        <li><time>2024</time><span>Began Ph.D. study at Stony Brook University with Prof. Fan Ye.</span></li>
        <li><time>2024</time><span>Graduated from Shanghai Jiao Tong University (SJTU). Outstanding Graduate of SJTU.</span></li>
        <li><time>2023</time><span>Second-author paper at IEEE GLOBECOM 2023.</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="publications">
    <div class="container">
      <h2 class="room-title">Selected publications</h2>
      <article class="pub">
        <div class="pub-year">2026</div>
        <div>
          <h3>ScoreKFT: Robust Scoring-Based Range Estimation for Human Tracking in Realistic Home-Like Environments with UWB Radars</h3>
          <p class="venue">IEEE Global Communications Conference (GLOBECOM) · Accepted</p>
          <p><strong>H. Fu</strong>, H. Han, M. Liu, Z. Xie, and F. Ye</p>
        </div>
      </article>
      <article class="pub">
        <div class="pub-year">2023</div>
        <div>
          <h3>Adaptive Processing for Video Streaming with Energy Constraint: A Multi-Agent Reinforcement Learning Method</h3>
          <p class="venue">IEEE GLOBECOM · Kuala Lumpur</p>
          <p>H. Liu, <strong>H. Fu</strong>, S. Yuan, C. Wu, Y. Luo, and J. Li</p>
        </div>
      </article>
      <p class="more"><a class="text-arrow" href="/publications">All publications</a></p>
    </div>
  </section>

  <style>
    .intro {
      padding: clamp(48px, 7vw, 110px) 0;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(32px, 5vw, 90px);
    }

    .intro-copy {
      min-width: 0;
    }

    .display-name {
      font-size: clamp(3.5rem, 7vw, 7rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
      margin: 0;
    }

    .name-cn {
      font-size: clamp(1.3rem, 2.2vw, 2rem);
      margin: 20px 0 48px;
      color: #777;
    }

    .intro-details {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .role {
      font-size: clamp(1rem, 1.35vw, 1.25rem);
      line-height: 1.65;
      margin: 0;
      overflow-wrap: break-word;
    }

    .nowrap {
      white-space: nowrap;
    }

    .inline-link,
    .quiet-links a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
    }

    .quiet-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 28px;
      margin-top: 44px;
      font-size: clamp(1rem, 1.35vw, 1.25rem);
    }

    .interests {
      margin: 32px 0 0;
      font-size: clamp(0.95rem, 1.25vw, 1.15rem);
      line-height: 1.8;
      color: #777;
      max-width: 620px;
    }

    .intro-photo {
      width: 100%;
      max-width: 480px;
      min-width: 0;
      margin: 0 auto;
      text-align: center;
    }

    .intro-photo img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 14px;
    }

    .intro-photo figcaption {
      margin-top: 14px;
      font-size: clamp(0.75rem, 1vw, 0.95rem);
      line-height: 1.6;
      color: #777;
      text-align: left;
    }

    /* Tablet and smaller desktop */
    @media (max-width: 1100px) {
      .intro-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 32px;
      }

      .display-name {
        font-size: clamp(3rem, 6vw, 5.5rem);
      }

      .name-cn {
        margin-bottom: 32px;
      }

      .quiet-links {
        margin-top: 30px;
      }

      .interests {
        margin-top: 24px;
      }
    }

    /* Tablet: Single column */
    @media (max-width: 850px) {
      .intro {
        padding: 56px 0;
      }

      .intro-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 44px;
      }

      .display-name {
        font-size: clamp(3.5rem, 9vw, 5.5rem);
      }

      .intro-photo {
        max-width: 400px;
      }

      .role {
        font-size: 1.1rem;
      }

      .quiet-links {
        font-size: 1.1rem;
      }
    }

    /* Mobile */
    @media (max-width: 480px) {
      .intro {
        padding: 40px 0 56px;
      }

      .intro-grid {
        gap: 36px;
      }

      .display-name {
        font-size: clamp(2.7rem, 11vw, 4rem);
      }

      .name-cn {
        font-size: 1.35rem;
        margin: 12px 0 30px;
      }

      .intro-details {
        gap: 10px;
      }

      .role {
        font-size: 0.95rem;
        line-height: 1.7;
      }

      .quiet-links {
        gap: 12px 22px;
        margin-top: 28px;
        font-size: 1rem;
      }

      .interests {
        margin-top: 26px;
        font-size: 0.95rem;
      }

      .intro-photo {
        max-width: 320px;
      }

      .intro-photo figcaption {
        font-size: 0.78rem;
      }
    }
  </style>
</Base>
