---
import Base from '../layouts/Base.astro';
import HeroFigure from '../components/HeroFigure.astro';
---
<Base title="Haotian Fu" active="home">
  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-copy">
        <h1 class="display-name">Haotian Fu</h1>
        <p class="name-cn">付昊天</p>
        <p class="role">Ph.D. Student, Computer Engineering</p>
        <p class="role">
          <a class="inline-link" href="https://www.stonybrook.edu/" target="_blank" rel="noopener">Stony Brook University</a>
        </p>
        <p class="role">Advised by <a class="inline-link" href="https://www.ece.stonybrook.edu/~fanye/index2.html" target="_blank" rel="noopener">Prof. Fan Ye</a> (IEEE Fellow)</p>
        <p class="quiet-links">
          <a href="/cv">CV</a>
          <a href="mailto:haotian.fu01@gmail.com">Email</a>
          <a href="https://github.com/Haotian-Fu" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/haotian-fu" target="_blank" rel="noopener">LinkedIn</a>
        </p>
        <p class="interests">
          Research interests: multimodal sensing, sensing infrastructure, and spatial intelligence.
        </p>
      </div>
      <figure class="intro-photo">
        <img src="/assets/img/avatar.jpg" alt="Portrait of Haotian Fu" />
        <figcaption>Stony Brook, New York</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="hello">
    <div class="container measure">
      <h2>Hello.</h2>
      <p>
        I am a third-year Ph.D. student in Computer Engineering at Stony Brook University.
        I build end-to-end sensing systems for indoor localization, activity recognition,
        and home-health monitoring — spanning UWB / RF sensing, multi-sensor fusion,
        dataset collection, and deep learning on GPU clusters.
      </p>
      <p>
        I am currently seeking a <strong>2027 summer internship</strong> in sensing systems,
        machine learning, or related applied research.
      </p>
    </div>
  </section>

  <section class="section" id="exhibit">
    <div class="container">
      <h2 class="room-title">Selected work</h2>
      <figure class="exhibit">
        <HeroFigure />
        <figcaption>
          Capture setup in a four-room apartment. Sixteen UWB radars, six RGB-D cameras,
          and wearables share one clock during continuous activities of daily living.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="research">
    <div class="container">
      <h2 class="room-title">Research</h2>
      <div class="catalog">
        <article class="catalog-item">
          <span class="catalog-no">01</span>
          <div>
            <h3>Multimodal dataset</h3>
            <p>
              Led acquisition and quality assessment for 113 long-duration ADL sessions
              with 16 UWB radars, 6 Kinect cameras, and wearables, including an Android
              collection app and metadata workflows.
            </p>
            <a class="text-arrow" href="/research">Read more</a>
          </div>
        </article>
        <article class="catalog-item">
          <span class="catalog-no">02</span>
          <div>
            <h3>ScoreKFT</h3>
            <p>
              Physics-informed UWB range scoring and particle-filter fusion over 16 sensors.
              0.958 m range RMSE, over 30% lower error than representative baselines.
              Accepted at IEEE GLOBECOM 2026.
            </p>
            <a class="text-arrow" href="/publications">Paper</a>
          </div>
        </article>
        <article class="catalog-item">
          <span class="catalog-no">03</span>
          <div>
            <h3>ADL-CLIP</h3>
            <p>
              Reproducing a Transformer RF–text contrastive model and evaluating
              cross-population generalization on Slurm-managed NVIDIA H200/B40 clusters.
            </p>
            <a class="text-arrow" href="/research">Read more</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="news">
    <div class="container measure">
      <h2 class="room-title">News</h2>
      <ul class="news">
        <li><time>2026</time><span>ScoreKFT accepted at IEEE GLOBECOM 2026.</span></li>
        <li><time>2026</time><span>Seeking a 2027 summer internship.</span></li>
        <li><time>2024</time><span>Began Ph.D. at Stony Brook University with Prof. Fan Ye.</span></li>
        <li><time>2024</time><span>B.E., Shanghai Jiao Tong University. Outstanding Graduate of SJTU.</span></li>
        <li><time>2023</time><span>Second-author paper at IEEE GLOBECOM 2023.</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="publications">
    <div class="container">
      <h2 class="room-title">Selected publications</h2>
      <article class="pub">
        <div class="pub-year">2026</div>
        <div>
          <h3>ScoreKFT: Robust Scoring-Based Range Estimation for Human Tracking in Realistic Home-Like Environments with UWB Radars</h3>
          <p class="venue">IEEE Global Communications Conference (GLOBECOM) · Accepted</p>
          <p><strong>H. Fu</strong>, M. Liu, H. Han, Z. Xie, and F. Ye</p>
        </div>
      </article>
      <article class="pub">
        <div class="pub-year">2023</div>
        <div>
          <h3>Adaptive Processing for Video Streaming with Energy Constraint: A Multi-Agent Reinforcement Learning Method</h3>
          <p class="venue">IEEE GLOBECOM · Kuala Lumpur</p>
          <p>H. Liu, <strong>H. Fu</strong>, S. Yuan, C. Wu, Y. Luo, and J. Li</p>
        </div>
      </article>
      <p class="more"><a class="text-arrow" href="/publications">All publications</a></p>
    </div>
  </section>
</Base>
